# PlanForge Environment Configuration
# Supported Google AI Studio / Gemini API credentials
# AI Studio automatically injects GEMINI_API_KEY and/or GEMMA_API_KEY from user secrets
GEMMA_API_KEY="MY_GEMMA_API_KEY"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Model Configuration
# Gemma 4 is natively supported via Google AI Studio (@google/genai SDK):
AI_MODEL="gemma-4-26b-a4b-it"
AI_PROVIDER="gemini"

# Server Configuration
PORT=3000
APP_URL="MY_APP_URL"
